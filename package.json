{
  "name": "changeproof",
  "version": "0.1.0",
  "description": "Evidence-grounded multimodal regression-testing agent synthesizing Playwright e2e suites from screen recordings",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "changeproof": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:regression": "node dist/cli.js test-regression",
    "test:repair": "node dist/cli.js repair --candidate fixtures/sample_app/v4_complete_redesign.html",
    "repair": "node dist/cli.js repair",
    "cli": "node dist/cli.js",
    "demo": "node dist/cli.js demo"

  },
  "keywords": [
    "meta",
    "playwright",
    "sam-3.1",
    "multimodal",
    "regression-testing",
    "e2e-testing",
    "ai-agent"
  ],
  "author": "Siddharth Srivastava",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
